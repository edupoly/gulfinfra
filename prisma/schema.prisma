generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  role            String    @default("user")
  passwordHash    String?   @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at")
  fullName        String?   @map("full_name")
  phone           String?
  company         String?
  jobTitle        String?   @map("job_title")
  country         String?
  profileImageUrl String?   @map("profile_image_url")
  blockedAt       DateTime? @map("blocked_at")
  blockedReason   String?   @map("blocked_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions                 AuthSession[]
  otps                     EmailOtp[]
  contractors              Contractor[]
  projectTenders           ProjectTender[]
  equipmentListings        Equipment[]
  materialListings         Material[]
  businessOpportunities    BusinessOpportunity[]
  savedListings            SavedListing[]
  rfqs                     Rfq[]                     @relation("RfqBuyer")
  vendorQuotations         VendorQuotation[]         @relation("QuotationSupplier")
  quotationMessages        QuotationMessage[]
  quotationEvents          QuotationEvent[]
  projectApplications      ProjectApplication[]      @relation("ProjectApplicant")
  projectApplicationEvents ProjectApplicationEvent[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  purpose    String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([userId, purpose, usedAt])
  @@map("email_otps")
}

model Category {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  description  String?
  icon         String?
  listingCount Int      @default(0) @map("listing_count")
  createdAt    DateTime @default(now()) @map("created_at")

  contractors           Contractor[]
  projectTenders        ProjectTender[]
  equipment             Equipment[]
  materials             Material[]
  businessOpportunities BusinessOpportunity[]

  @@map("categories")
}

model ContractorType {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  contractorLinks ContractorTypeLink[]

  @@map("contractor_types")
}

model ProjectTenderType {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  projectTenderLinks ProjectTenderTypeLink[]

  @@map("project_tender_types")
}

model EquipmentType {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  equipment Equipment[]

  @@map("equipment_types")
}

model MaterialTypeOption {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  groupName String   @map("group_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([groupName])
  @@map("material_type_options")
}

model BusinessCategoryOption {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("business_category_options")
}

model RfqCategoryOption {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("rfq_category_options")
}

model RfqSequence {
  year  Int @id
  value Int @default(0)

  @@map("rfq_sequences")
}

model Country {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  cities                    City[]
  contractorLinks           ContractorCountryLink[]
  projectTenderCountryLinks ProjectTenderCountryLink[]
  equipment                 Equipment[]
  materials                 Material[]
  businessOpportunities     BusinessOpportunity[]

  @@map("countries")
}

model City {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  countryCode String   @map("country_code")
  createdAt   DateTime @default(now()) @map("created_at")

  country Country @relation(fields: [countryCode], references: [code])

  contractorLinks        ContractorCityLink[]
  projectTenderCityLinks ProjectTenderCityLink[]
  equipment              Equipment[]
  materials              Material[]
  businessOpportunities  BusinessOpportunity[]

  @@map("cities")
}

model Contractor {
  id                String   @id @default(uuid())
  slug              String   @unique
  categorySlug      String   @map("category_slug")
  name              String
  companyType       String   @map("company_type")
  listingStatus     String   @default("published") @map("listing_status")
  draftTokenHash    String?  @map("draft_token_hash")
  logoUrl           String?  @map("logo_url")
  primaryTypeSlug   String?  @map("primary_type_slug")
  countryCode       String?  @map("country_code")
  citySlug          String?  @map("city_slug")
  yearEstablished   Int?     @map("year_established")
  employees         String?
  website           String?
  email             String?
  phone             String?
  whatsapp          String?
  address           String?
  description       String?
  rating            Float?   @default(0)
  reviewCount       Int?     @default(0) @map("review_count")
  verified          Boolean  @default(false)
  premium           Boolean  @default(false)
  featured          Boolean  @default(false)
  memberSince       String?  @map("member_since")
  responseTime      String?  @map("response_time")
  projectsCompleted Int?     @default(0) @map("projects_completed")
  createdAt         DateTime @default(now()) @map("created_at")
  ownerId           String?  @map("owner_id")

  category Category @relation(fields: [categorySlug], references: [slug])
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  contractorTypes  ContractorTypeLink[]
  countries        ContractorCountryLink[]
  cities           ContractorCityLink[]
  services         ContractorService[]
  areasServed      ContractorAreaServed[]
  licenses         ContractorLicense[]
  galleryItems     ContractorGalleryItem[]
  documents        ContractorDocument[]
  featuredProjects ContractorFeaturedProject[]

  @@map("contractors")
}

model ContractorTypeLink {
  contractorId       String @map("contractor_id")
  contractorTypeSlug String @map("contractor_type_slug")

  contractor     Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  contractorType ContractorType @relation(fields: [contractorTypeSlug], references: [slug])

  @@id([contractorId, contractorTypeSlug])
  @@map("contractor_type_links")
}

model ContractorCountryLink {
  contractorId String @map("contractor_id")
  countryCode  String @map("country_code")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  country    Country    @relation(fields: [countryCode], references: [code])

  @@id([contractorId, countryCode])
  @@map("contractor_country_links")
}

model ContractorCityLink {
  contractorId String @map("contractor_id")
  citySlug     String @map("city_slug")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  city       City       @relation(fields: [citySlug], references: [slug])

  @@id([contractorId, citySlug])
  @@map("contractor_city_links")
}

model ContractorService {
  id           String   @id @default(uuid())
  contractorId String   @map("contractor_id")
  serviceName  String   @map("service_name")
  createdAt    DateTime @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_services")
}

model ContractorAreaServed {
  id           String   @id @default(uuid())
  contractorId String   @map("contractor_id")
  areaName     String   @map("area_name")
  createdAt    DateTime @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_areas_served")
}

model ContractorLicense {
  id           String   @id @default(uuid())
  contractorId String   @map("contractor_id")
  licenseName  String   @map("license_name")
  createdAt    DateTime @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_licenses")
}

model ContractorGalleryItem {
  id           String   @id @default(uuid())
  contractorId String   @map("contractor_id")
  imageUrl     String   @map("image_url")
  createdAt    DateTime @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_gallery_items")
}

model ContractorDocument {
  id           String   @id @default(uuid())
  contractorId String   @map("contractor_id")
  name         String
  documentType String   @map("document_type")
  documentUrl  String   @map("document_url")
  createdAt    DateTime @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_documents")
}

model ContractorFeaturedProject {
  id           String   @id @default(uuid())
  contractorId String   @map("contractor_id")
  title        String
  location     String
  status       String
  createdAt    DateTime @default(now()) @map("created_at")

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@map("contractor_featured_projects")
}

model ProjectTender {
  id             String   @id @default(uuid())
  slug           String   @unique
  categorySlug   String   @map("category_slug")
  listingStatus  String   @default("published") @map("listing_status")
  draftTokenHash String?  @map("draft_token_hash")
  title          String
  projectType    String?  @map("project_type")
  status         String
  summary        String?
  description    String?
  budget         String?
  deadline       String?
  client         String?
  value          String?
  tenderType     String?  @map("tender_type")
  location       String?
  posted         String?
  featured       Boolean  @default(false)
  imageUrls      String[] @default([]) @map("image_urls")
  createdAt      DateTime @default(now()) @map("created_at")
  ownerId        String?  @map("owner_id")

  category Category @relation(fields: [categorySlug], references: [slug])
  owner    User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  projectTenderTypes ProjectTenderTypeLink[]
  countries          ProjectTenderCountryLink[]
  cities             ProjectTenderCityLink[]
  sectors            ProjectTenderSector[]
  documents          ProjectTenderDocument[]
  applications       ProjectApplication[]

  @@map("project_tenders")
}

model ProjectTenderTypeLink {
  projectTenderId       String @map("project_tender_id")
  projectTenderTypeSlug String @map("project_tender_type_slug")

  projectTender     ProjectTender     @relation(fields: [projectTenderId], references: [id], onDelete: Cascade)
  projectTenderType ProjectTenderType @relation(fields: [projectTenderTypeSlug], references: [slug])

  @@id([projectTenderId, projectTenderTypeSlug])
  @@map("project_tender_type_links")
}

model ProjectTenderCountryLink {
  projectTenderId String @map("project_tender_id")
  countryCode     String @map("country_code")

  projectTender ProjectTender @relation(fields: [projectTenderId], references: [id], onDelete: Cascade)
  country       Country       @relation(fields: [countryCode], references: [code])

  @@id([projectTenderId, countryCode])
  @@map("project_tender_country_links")
}

model ProjectTenderCityLink {
  projectTenderId String @map("project_tender_id")
  citySlug        String @map("city_slug")

  projectTender ProjectTender @relation(fields: [projectTenderId], references: [id], onDelete: Cascade)
  city          City          @relation(fields: [citySlug], references: [slug])

  @@id([projectTenderId, citySlug])
  @@map("project_tender_city_links")
}

model ProjectTenderSector {
  id              String   @id @default(uuid())
  projectTenderId String   @map("project_tender_id")
  sectorName      String   @map("sector_name")
  createdAt       DateTime @default(now()) @map("created_at")

  projectTender ProjectTender @relation(fields: [projectTenderId], references: [id], onDelete: Cascade)

  @@map("project_tender_sectors")
}

model ProjectTenderDocument {
  id              String   @id @default(uuid())
  projectTenderId String   @map("project_tender_id")
  name            String
  documentType    String   @map("document_type")
  documentUrl     String   @map("document_url")
  createdAt       DateTime @default(now()) @map("created_at")

  projectTender ProjectTender @relation(fields: [projectTenderId], references: [id], onDelete: Cascade)

  @@map("project_tender_documents")
}

model ProjectApplication {
  id                    String    @id @default(uuid())
  projectTenderId       String    @map("project_tender_id")
  applicantId           String    @map("applicant_id")
  companyName           String    @map("company_name")
  contactPerson         String    @map("contact_person")
  contactEmail          String    @map("contact_email")
  contactPhone          String    @map("contact_phone")
  proposedRole          String    @map("proposed_role")
  coverMessage          String    @map("cover_message")
  supportingDocumentUrl String?   @map("supporting_document_url")
  status                String    @default("submitted")
  submittedAt           DateTime  @default(now()) @map("submitted_at")
  withdrawnAt           DateTime? @map("withdrawn_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  projectTender ProjectTender             @relation(fields: [projectTenderId], references: [id], onDelete: Cascade)
  applicant     User                      @relation("ProjectApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  events        ProjectApplicationEvent[]

  @@unique([projectTenderId, applicantId])
  @@index([applicantId, status])
  @@index([projectTenderId, status])
  @@map("project_applications")
}

model ProjectApplicationEvent {
  id            String   @id @default(uuid())
  applicationId String   @map("application_id")
  actorId       String?  @map("actor_id")
  status        String
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  application ProjectApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("project_application_events")
}

model Equipment {
  id                String   @id @default(uuid())
  slug              String   @unique
  categorySlug      String   @default("equipment-marketplace") @map("category_slug")
  listingStatus     String   @default("published") @map("listing_status")
  draftTokenHash    String?  @map("draft_token_hash")
  title             String
  equipmentTypeSlug String   @map("equipment_type_slug")
  listingType       String   @map("listing_type")
  condition         String
  countryCode       String   @map("country_code")
  citySlug          String   @map("city_slug")
  brand             String
  model             String
  year              Int
  operatingHours    Int?     @map("operating_hours")
  price             String
  priceNote         String?  @map("price_note")
  availability      String
  location          String
  description       String
  specifications    Json
  sellerName        String   @map("seller_name")
  sellerType        String   @map("seller_type")
  phone             String
  whatsapp          String?
  email             String?
  verified          Boolean  @default(false)
  featured          Boolean  @default(false)
  images            String[]
  posted            String?
  createdAt         DateTime @default(now()) @map("created_at")
  ownerId           String?  @map("owner_id")

  category      Category            @relation(fields: [categorySlug], references: [slug])
  equipmentType EquipmentType       @relation(fields: [equipmentTypeSlug], references: [slug])
  country       Country             @relation(fields: [countryCode], references: [code])
  city          City                @relation(fields: [citySlug], references: [slug])
  documents     EquipmentDocument[]
  owner         User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([equipmentTypeSlug])
  @@index([listingType])
  @@index([condition])
  @@index([countryCode])
  @@map("equipment")
}

model EquipmentDocument {
  id           String   @id @default(uuid())
  equipmentId  String   @map("equipment_id")
  name         String
  documentType String   @map("document_type")
  documentUrl  String   @map("document_url")
  createdAt    DateTime @default(now()) @map("created_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@map("equipment_documents")
}

model Material {
  id               String   @id @default(uuid())
  slug             String   @unique
  categorySlug     String   @default("construction-materials") @map("category_slug")
  listingStatus    String   @default("published") @map("listing_status")
  draftTokenHash   String?  @map("draft_token_hash")
  name             String
  materialGroup    String   @map("material_group")
  materialType     String   @map("material_type")
  materialTypeSlug String   @map("material_type_slug")
  listingType      String   @map("listing_type")
  countryCode      String   @map("country_code")
  citySlug         String   @map("city_slug")
  supplier         String
  priceRange       String   @map("price_range")
  minimumOrder     String   @map("minimum_order")
  availability     String
  leadTime         String   @map("lead_time")
  compliance       String[]
  description      String
  specifications   Json
  phone            String
  whatsapp         String?
  email            String?
  verified         Boolean  @default(false)
  featured         Boolean  @default(false)
  image            String?
  galleryImages    String[] @default([]) @map("gallery_images")
  posted           String?
  createdAt        DateTime @default(now()) @map("created_at")
  ownerId          String?  @map("owner_id")

  category  Category           @relation(fields: [categorySlug], references: [slug])
  country   Country            @relation(fields: [countryCode], references: [code])
  city      City               @relation(fields: [citySlug], references: [slug])
  documents MaterialDocument[]
  owner     User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([materialGroup])
  @@index([materialTypeSlug])
  @@index([listingType])
  @@index([countryCode])
  @@map("materials")
}

model MaterialDocument {
  id           String   @id @default(uuid())
  materialId   String   @map("material_id")
  name         String
  documentType String   @map("document_type")
  documentUrl  String   @map("document_url")
  createdAt    DateTime @default(now()) @map("created_at")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_documents")
}

model BusinessOpportunity {
  id               String   @id @default(uuid())
  slug             String   @unique
  categorySlug     String   @default("business-opportunities") @map("category_slug")
  listingStatus    String   @default("published") @map("listing_status")
  draftTokenHash   String?  @map("draft_token_hash")
  title            String
  section          String
  businessCategory String   @map("business_category")
  investment       String
  countryCode      String   @map("country_code")
  citySlug         String   @map("city_slug")
  contact          String
  phone            String
  whatsapp         String?
  description      String
  featured         Boolean  @default(false)
  image            String?
  galleryImages    String[] @default([]) @map("gallery_images")
  postedDate       String?  @map("posted_date")
  createdAt        DateTime @default(now()) @map("created_at")
  ownerId          String?  @map("owner_id")

  category  Category                      @relation(fields: [categorySlug], references: [slug])
  country   Country                       @relation(fields: [countryCode], references: [code])
  city      City                          @relation(fields: [citySlug], references: [slug])
  documents BusinessOpportunityDocument[]
  owner     User?                         @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([section])
  @@index([businessCategory])
  @@index([countryCode])
  @@map("business_opportunities")
}

model BusinessOpportunityDocument {
  id                    String   @id @default(uuid())
  businessOpportunityId String   @map("business_opportunity_id")
  name                  String
  documentType          String   @map("document_type")
  documentUrl           String   @map("document_url")
  createdAt             DateTime @default(now()) @map("created_at")

  businessOpportunity BusinessOpportunity @relation(fields: [businessOpportunityId], references: [id], onDelete: Cascade)

  @@map("business_opportunity_documents")
}

model Rfq {
  id                       String    @id @default(uuid())
  reference                String    @unique
  title                    String
  projectName              String    @map("project_name")
  materialService          String?   @map("material_service")
  category                 String
  status                   String    @default("draft")
  country                  String
  city                     String
  address                  String?
  quantity                 String
  unit                     String?
  specifications           String?
  notes                    String?
  budget                   String?
  urgency                  String
  deliveryDate             DateTime? @map("delivery_date")
  expirationDate           DateTime  @map("expiration_date")
  deliveryTerms            String    @map("delivery_terms")
  description              String
  phone                    String
  email                    String
  boqUrl                   String?   @map("boq_url")
  drawingsUrl              String?   @map("drawings_url")
  specificationDocumentUrl String?   @map("specification_document_url")
  otherDocumentUrls        String[]  @default([]) @map("other_document_urls")
  postedAt                 DateTime  @default(now()) @map("posted_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  buyerId                  String?   @map("buyer_id")
  awardedAt                DateTime? @map("awarded_at")

  quotations VendorQuotation[]
  buyer      User?             @relation("RfqBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([buyerId, status])
  @@index([status])
  @@index([category])
  @@index([expirationDate])
  @@map("rfqs")
}

model VendorQuotation {
  id                     String    @id @default(uuid())
  rfqId                  String    @map("rfq_id")
  vendorName             String    @map("vendor_name")
  offerAmount            String    @map("offer_amount")
  deliveryLeadtime       String    @map("delivery_leadtime")
  technicalSpecification String    @map("technical_specification")
  vendorNotes            String?   @map("vendor_notes")
  pdfUrl                 String?   @map("pdf_url")
  status                 String    @default("pending")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  supplierId             String?   @map("supplier_id")
  companyName            String?   @map("company_name")
  contactPerson          String?   @map("contact_person")
  contactEmail           String?   @map("contact_email")
  contactPhone           String?   @map("contact_phone")
  unitPrice              String?   @map("unit_price")
  totalPrice             String?   @map("total_price")
  currency               String?
  warranty               String?
  paymentTerms           String?   @map("payment_terms")
  validUntil             DateTime? @map("valid_until")
  submittedAt            DateTime? @map("submitted_at")
  withdrawnAt            DateTime? @map("withdrawn_at")

  rfq      Rfq                @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier User?              @relation("QuotationSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  messages QuotationMessage[]
  events   QuotationEvent[]

  @@unique([rfqId, supplierId])
  @@index([rfqId])
  @@index([supplierId, status])
  @@index([status])
  @@map("vendor_quotations")
}

model QuotationMessage {
  id            String   @id @default(uuid())
  quotationId   String   @map("quotation_id")
  senderId      String   @map("sender_id")
  body          String
  attachmentUrl String?  @map("attachment_url")
  createdAt     DateTime @default(now()) @map("created_at")

  quotation VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sender    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([quotationId, createdAt])
  @@map("quotation_messages")
}

model QuotationEvent {
  id          String   @id @default(uuid())
  quotationId String   @map("quotation_id")
  actorId     String?  @map("actor_id")
  status      String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  quotation VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([quotationId, createdAt])
  @@map("quotation_events")
}

model ContactSubmission {
  id              String   @id @default(uuid())
  fullName        String   @map("full_name")
  phoneOrWhatsapp String   @map("phone_or_whatsapp")
  email           String
  message         String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_submissions")
}

model SavedListing {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  listingType String   @map("listing_type")
  listingSlug String   @map("listing_slug")
  title       String
  href        String
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingType, listingSlug])
  @@index([userId, createdAt])
  @@map("saved_listings")
}
